    "from openpyxl.utils import get_column_letter\n",
    "import os\n",
    "\n",
    "def save_pivot_to_excel(pivot: pd.DataFrame, filename: str, sheet_name='Resultados'):\n",
    "    \"\"\"\n",
    "    Guarda `pivot` en un archivo .xlsx manteniendo su MultiIndex de columnas,\n",
    "    usando openpyxl (no necesitas instalar xlsxwriter).\n",
    "    \"\"\"\n",
    "    mode = 'a' if os.path.exists(filename) else 'w'\n",
    "    \n",
    "    with pd.ExcelWriter(\n",
    "        filename,\n",
    "        engine='openpyxl',\n",
    "        mode=mode,\n",
    "    ) as writer:\n",
    "        # Volcar el pivot\n",
    "        pivot.to_excel(\n",
    "            writer,\n",
    "            sheet_name=sheet_name,\n",
    "            merge_cells=True\n",
    "        )\n",
    "\n",
    "        # Ajuste opcional de ancho de columnas\n",
    "        workbook  = writer.book\n",
    "        worksheet = writer.sheets[sheet_name]\n",
    "\n",
    "        for idx, col in enumerate(pivot.columns, start=1):\n",
    "            header_len = len(str(col[0])) + len(str(col[1])) + 1\n",
    "            col_values = pivot[col].astype(str).map(len)\n",
    "            max_len = max(header_len, col_values.max() if not col_values.empty else 0)\n",
    "            excel_col = get_column_letter(idx + 1)\n",
    "            worksheet.column_dimensions[excel_col].width = max_len + 2\n",
    "\n",
    "    print(f\"Guardado correctamente en '{filename}' (hoja: '{sheet_name}')\")"
   ]
  },

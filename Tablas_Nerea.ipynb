    "def calculate_table(metric_col, df_full, df_original, df_latent, inertal_percentage=0.2,space='original'):\n",
    "    metric_col = 'test_balanced'\n",
    "\n",
    "    # Transformacion de latentes\n",
    "    df_latent = df_latent[df_latent.space==space]\n",
    "\n",
    "    df_shopper_latent_g = (\n",
    "        df_latent\n",
    "            .groupby(['method', 'model', 'IPC'], as_index=False)\n",
    "            .agg(**{\n",
    "                f'{metric_col}_latent_mean': (metric_col, 'mean'),\n",
    "                f'{metric_col}_latent_std':  (metric_col, 'std')\n",
    "            })\n",
    "    )\n",
    "\n",
    "    df_shopper_latent_g = df_shopper_latent_g.rename(columns={'IPC':'percentage'})\n",
    "    df_shopper_latent_g = df_shopper_latent_g[df_shopper_latent_g.method == 'k-means']\n",
    "\n",
    "    # Transformacion de original\n",
    "    df_shopper_original_g = (\n",
    "    df_original\n",
    "        .groupby(['method', 'model', 'IPC'], as_index=False)\n",
    "        .agg(**{\n",
    "            f'{metric_col}_original_mean': (metric_col, 'mean'),\n",
    "            f'{metric_col}_original_std':  (metric_col, 'std')\n",
    "            })\n",
    "    )\n",
    "\n",
    "    df_shopper_original_g = df_shopper_original_g.rename(columns={'IPC':'percentage'})\n",
    "    df_shopper_original_g = df_shopper_original_g[df_shopper_original_g.method == 'k-means']\n",
    "    df_shopper_original_g = df_shopper_original_g[df_shopper_original_g.percentage <= inertal_percentage]\n",
    "\n",
    "    df_shopper_inner = pd.merge(df_shopper_latent_g, df_shopper_original_g,\n",
    "                on=['method','model','percentage'],\n",
    "                how='inner',    # 'inner' o 'outer' según necesites\n",
    "                sort=False)     # sort=False preserva el orden de df1\n",
    "\n",
    "    pivot = (\n",
    "        df_shopper_inner\n",
    "        .pivot(index=\"model\",\n",
    "                columns=\"percentage\",\n",
    "                values=[\"test_balanced_latent_mean\", \"test_balanced_latent_std\",\n",
    "                        \"test_balanced_original_mean\", \"test_balanced_original_std\"])\n",
    "        .swaplevel(0, 1, axis=1)\n",
    "        .sort_index(axis=1, level=0)\n",
    "        .rename_axis(index=None, columns=[None, None])\n",
    "    )\n",
    "    pivot = pivot.rename(columns={'test_balanced_latent_mean':'latent_mean',\n",
    "                                'test_balanced_latent_std':'latent_std',\n",
    "                                'test_balanced_original_mean':'original_mean',\n",
    "                                'test_balanced_original_std':'original_std',\n",
    "                                })\n",
    "\n",
    "    df_full = df_full.rename(columns={'test_balanced':'full'})\n",
    "    # Serie con índice modelo y valores test_balanced\n",
    "    ser = df_full.set_index('model')['full']\n",
    "\n",
    "    # Insertas en la primera posición del MultiIndex\n",
    "    pivot.insert(\n",
    "        loc=0,\n",
    "        column=(0, 'full'),\n",
    "        value=ser\n",
    "    )\n",
    "\n",
    "    # (Opcional) Asegúrate de que el orden de porcentajes quede correcto\n",
    "    pivot = pivot.sort_index(axis=1, level=0)\n",
    "    pivot = pivot.round(3)\n",
    "    \n",
    "    return pivot\n"
   ]
  },
